# Source data. The workbook is roughly 30 MB and is dunnhumby's to distribute,
# so it is fetched rather than committed. See the README for where to get it.
data/raw/*
data/interim/*
data/processed/*
!data/**/.gitkeep
*.xlsx
*.xls
*.csv.gz
*.zip

# Fitted artefacts. Regenerated by `python run_pipeline.py`, and large.
outputs/models/*
!outputs/models/.gitkeep
*.nc
*.npy
*.pkl
*.joblib

# outputs/figures and outputs/tables are intentionally NOT ignored. The README
# and the documents in docs/ are generated from those tables and embed those
# figures, so a fresh clone renders correctly without running the pipeline.

# Credentials
.env
.env.*
*.pem
credentials.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Tooling
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.pytensor/

# OS
.DS_Store
Thumbs.db
